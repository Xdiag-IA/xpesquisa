# Variáveis de ambiente do processo; este arquivo não é carregado automaticamente.
XPESQUISA_DATA_DIR=./data
# extractive (padrão, sem IA) ou ollama (requer modelo instalado localmente)
XPESQUISA_PROVIDER=extractive
XPESQUISA_MODEL=
XPESQUISA_OLLAMA_URL=http://127.0.0.1:11434
# Reservada para futuros providers; não usada pelo MVP.
XPESQUISA_API_KEY=
# Resolução independente de DOI/PMID (doi.org, NCBI E-utilities) não requer
# chave. Identificação da ferramenta já embutida no código (User-Agent e
# parâmetro tool=xpesquisa), conforme as políticas de uso de cada uma.
