XPESQUISA_PROVIDER=extractive
XPESQUISA_MODEL=
XPESQUISA_OLLAMA_URL=http://127.0.0.1:11434
# Reservada para futuros providers; não usada pelo MVP.
XPESQUISA_API_KEY=
